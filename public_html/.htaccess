Options -MultiViews
RewriteEngine On

# 1. Forward all /api requests to the Node.js backend on port 5000
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^api/(.*)$ http://127.0.0.1:5000/api/$1 [P,L]
RewriteRule ^api$ http://127.0.0.1:5000/api/ [P,L]

# 2. Serve static assets if they exist
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 3. For any other client-side React routes, serve index.html
RewriteRule ^ index.html [QSA,L]
