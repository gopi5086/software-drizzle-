<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Do not touch or rewrite any API routes - let Node.js handle them
    RewriteRule ^api/ - [L]
    RewriteRule ^api$ - [L]

    # 2. Serve static assets if they exist directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Client-side React SPA fallback
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
